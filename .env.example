# ─────────────────────────────────────────────────────────────────────────────
# DealFinder AI — environment template
#
# Copy to `.env` and adjust. `.env` is gitignored: never commit real
# credentials. Every variable below is validated at API boot by
# apps/api/src/env.ts — the process exits with a readable error if a required
# value is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info
TZ=Europe/Helsinki

# ── Database ─────────────────────────────────────────────────────────────────
# Option A (default, no Docker required): `npm run db:dev` starts Prisma's
# bundled local PostgreSQL server (real Postgres 17 via PGlite) on port 51214
# and prints this exact connection string.
#
# Use 127.0.0.1, NOT localhost. The server binds IPv4 only, and on Windows
# Node resolves "localhost" to ::1 first, which fails with ECONNREFUSED.
#
# Option B (standard/production): `docker compose up -d` then use:
#   postgresql://dealfinder:dealfinder@127.0.0.1:5432/dealfinder?schema=public
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable"

# Connection-pool size.
#
# Keep this at 1 when using the "npm run db:dev" database. That server is PGlite
# behind a socket bridge and accepts only ONE connection at a time: a larger
# pool fails with ECONNRESET the moment two requests overlap, and it fails
# confusingly — a trivial health check still passes while every real query dies.
#
# Raise it (e.g. 10) for a real PostgreSQL server, such as the docker-compose one.
DATABASE_POOL_MAX=1

# ── API server ───────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173

# Public base URL of the web app. Used to build links inside alert emails.
APP_URL=http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Cross-store matching ─────────────────────────────────────────────────────
# See docs/product-matching.md for what these do and how they were calibrated.
#
# Score at or above which a high-confidence, conflict-free pair is grouped
# automatically. Raise it to send more pairs to the review queue instead.
MATCH_AUTO_ATTACH_MIN_SCORE=88
# Score at or above which a pair is stored as a candidate for review. Anything
# below is discarded and never written — that is how "never silently merge a
# low-confidence match" is enforced. Must be below the auto-attach score.
MATCH_REVIEW_MIN_SCORE=62

# Optional AI-assisted review of ambiguous medium-confidence candidates.
# Off, and shipped with no implementation behind it: the deterministic engine
# is what decides, and the entire application works with no AI API key.
MATCH_AI_REVIEW_ENABLED=false
# Whether an AI endorsement may stand in for a human approval. Off.
MATCH_AI_AUTO_APPROVE=false

# ── Development authentication ───────────────────────────────────────────────
# The MVP has no real auth. Requests resolve to this seeded user unless an
# `x-user-email` header overrides it. See docs/architecture.md for the seam
# where Auth.js / Clerk / Supabase Auth would be dropped in.
DEV_USER_EMAIL=demo@dealfinder.test
DEV_USER_NAME=Demo User

# ── Store providers ──────────────────────────────────────────────────────────
# mock = bundled realistic sample data (default; no network access).
# live = Playwright / structured-data adapters. READ docs/legal-and-ethics.md
#        BEFORE enabling: you are responsible for complying with each site's
#        terms of service, robots.txt, rate limits and applicable law.
PROVIDER_MODE=mock
PROVIDER_TIMEOUT_MS=10000
PROVIDER_MAX_RETRIES=2
PROVIDER_MAX_CONCURRENCY=3

# Mock-only knobs: simulate latency and failures so error handling is testable.
PROVIDER_MOCK_MIN_LATENCY_MS=40
PROVIDER_MOCK_MAX_LATENCY_MS=180
PROVIDER_MOCK_FAILURE_RATE=0

# ── Scheduled price monitoring ───────────────────────────────────────────────
MONITOR_ENABLED=true
# Standard 5-field cron expression. Default: every 30 minutes.
MONITOR_CRON=*/30 * * * *
MONITOR_BATCH_SIZE=25
# Minimum hours between two alerts for the same watchlist item.
ALERT_COOLDOWN_HOURS=12

# ── Email (Nodemailer) ───────────────────────────────────────────────────────
# stream = write .eml files to EMAIL_OUTPUT_DIR (default; nothing is sent)
# json   = log the serialised message only
# smtp   = real delivery via the SMTP_* settings below
EMAIL_TRANSPORT=stream
EMAIL_FROM="DealFinder AI <alerts@dealfinder.test>"
EMAIL_OUTPUT_DIR=apps/api/.mail

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Web app (Vite — only VITE_* names reach the browser bundle) ───────────────
VITE_API_URL=http://localhost:4000
